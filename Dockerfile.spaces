# ─────────────────────────────────────────────────────────────────────────────
# Dockerfile pour Hugging Face Spaces
#
# Différences vs Dockerfile principal :
#   - Port 7860  (requis par HF Spaces)
#   - Pas d'Ollama (LLM = Anthropic API via ANTHROPIC_API_KEY secret HF)
#   - Build mono-stage allégé (HF gère déjà le cache de couches)
#   - User non-root uid 1000 (convention HF)
#
# Déploiement :
#   1. Créer un Space HF de type "Docker" depuis https://huggingface.co/new-space
#   2. Pousser ce dépôt sur le Space (git remote add space ...)
#   3. Ajouter ANTHROPIC_API_KEY dans Settings > Secrets du Space
# ─────────────────────────────────────────────────────────────────────────────

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    # Streamlit — HF Spaces écoute sur le port 7860
    STREAMLIT_SERVER_PORT=7860 \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false \
    STREAMLIT_SERVER_ENABLE_CORS=false \
    STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=true \
    # Désactive Ollama (non disponible sur HF — LLM via Anthropic API)
    OLLAMA_BASE_URL=""

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl \
    && rm -rf /var/lib/apt/lists/*

# Utilisateur non-root uid 1000 (convention HF Spaces)
RUN useradd --uid 1000 --shell /bin/bash --create-home appuser

WORKDIR /app

COPY requirements.txt .
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY --chown=appuser:appuser backend/    ./backend/
COPY --chown=appuser:appuser frontend/   ./frontend/
COPY --chown=appuser:appuser .streamlit/ ./.streamlit/

RUN mkdir -p /app/saved_models && chown appuser:appuser /app/saved_models

USER appuser

EXPOSE 7860

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl --fail --silent http://localhost:7860/_stcore/health || exit 1

CMD ["streamlit", "run", "frontend/app.py", "--server.port=7860"]
